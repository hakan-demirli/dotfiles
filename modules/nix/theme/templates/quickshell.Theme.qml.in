        readonly property color m3warning: "{{colour-warning}}"
        readonly property color m3warningContainer: "{{colour-warning-container}}"
    }

    component ShapeTokens: QtObject {
        readonly property int extraLarge: {{radius-extra-large}}
        readonly property int extraSmall: {{radius-extra-small}}
        readonly property int full: {{radius-full}}
        readonly property int large: {{radius-large}}
        readonly property int medium: {{radius-medium}}
        readonly property int none: {{radius-none}}
        readonly property int small: {{radius-small}}
    }

    component SpaceTokens: QtObject {
        readonly property int extraLarge: {{space-extra-large}}
