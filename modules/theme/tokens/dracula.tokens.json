    "syntax": {
      "$type": "color",
      "bracketsParensBraces": {
        "foreground": {
          "$value": "{dracula.color.foreground}"
        }
      },
      "builtInFunctions": {
        "foreground": {
          "$value": "{dracula.color.cyan}"
        }
      },
      "builtInMagicMethodsOrConstants": {
        "foreground": {
          "$value": "{dracula.color.purple}"
        }
      },
      "className": {
        "foreground": {
          "$value": "{dracula.color.cyan}"
        }
      },
      "comment": {
        "foreground": {
          "$value": "{dracula.color.comment}"
        }
      },
      "constant": {
        "foreground": {
          "$value": "{dracula.color.purple}"
        }
      },
      "constantEscapeSequences": {
        "foreground": {
          "$value": "{dracula.color.pink}"
        }
      },
      "cssParentSelectors": {
        "foreground": {
          "$value": "{dracula.color.pink}"
        }
      },
      "dateTime": {
        "foreground": {
          "$value": "{dracula.color.orange}"
        }
      },
      "decorators": {
        "$extensions": {
          "com.github.hakan-demirli.dotfiles": {
            "decoration": ["italic"]
          }
        },
        "foreground": {
          "$value": "{dracula.color.green}"
        }
      },
      "deprecated": {
        "foreground": {
          "$value": "{dracula.color.foreground}"
        },
        "background": {
          "$value": "{dracula.color.purple}"
        }
      },
      "destructuringAliasLhs": {
        "$extensions": {
          "com.github.hakan-demirli.dotfiles": {
            "decoration": ["italic"]
          }
        },
        "foreground": {
          "$value": "{dracula.color.orange}"
        }
      },
      "destructuringAliasRhs": {
        "foreground": {
          "$value": "{dracula.color.foreground}"
        }
      },
      "diffChanged": {
        "foreground": {
          "$value": "{dracula.color.orange}"
        }
      },
      "diffDeleted": {
        "foreground": {
          "$value": "{dracula.color.red}"
        }
