background {
    monitor =
    path = /tmp/wp.webp
}

auth {
    fingerprint:enabled = true
    fingerprint:ready_message = Scan finger to unlock
    fingerprint:present_message = Scanning...
}

input-field {
    monitor =
    size = 250, 50
    outline_thickness = 3
    dots_size = 0.2
    dots_spacing = 0.64
    dots_center = true
    fade_on_empty = true
    placeholder_text = <i>Password...</i>
    hide_input = false
    position = 0, 65
    halign = center
    valign = bottom
}

label {
    monitor =
    text = cmd[update:1000] echo "<b><big> $(date +"%H:%M:%S") </big></b>"
    font_size = {{text-display-large}}
    font_family = {{font-plain}}
    position = 0, 0
    halign = center
    valign = center

    shadow_passes = 3
    shadow_size = {{space-extra-small}}
}

label {
    monitor =
    text = Type to unlock!
    font_size = {{text-body-large}}
    font_family = {{font-plain}}
    position = 0, 30
    halign = center
    valign = bottom

    shadow_passes = 3
    shadow_size = {{space-extra-small}}
}
