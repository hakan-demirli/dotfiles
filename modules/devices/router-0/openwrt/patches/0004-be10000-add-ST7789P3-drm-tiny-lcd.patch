From 156b46ba7bf42e3c546bbeb557f4c23edd8de9f8 Mon Sep 17 00:00:00 2001
From: hakan-demirli <ehdemirli@proton.me>
Date: Wed, 3 Jun 2026 21:06:41 +0200
Subject: [PATCH] be10000: add ST7789P3 LCD support (DRM-tiny)

Adds ST7789P3 240x320 SPI panel support via the DRM-tiny driver
(drivers/gpu/drm/tiny/st7789p3.c) plus:

  - MediaTek DTS wiring: spi bus + panel node + panel-supply regulator
  - config-6.18: DRM + DRM_TINY + DRM_ST7789P3, DRM_KMS_HELPER on-y
  - kernel packaging: kmod-drm-st7789p3 in linux/modules/video.mk
  - bindings: sitronix,st7789p3.yaml devicetree schema doc

Enables the on-device 240x320 touchscreen (touch controller wired by
patch 0002) as /dev/fb0 for the r01-ui touchscreen application.

Signed-off-by: hakan-demirli <ehdemirli@proton.me>
---
 package/kernel/linux/modules/video.mk         |  21 +
 .../dts/mt7987a-glinet-gl-be10000.dts         |  37 ++
 target/linux/mediatek/filogic/config-6.18     |  15 +
 .../998-drm-tiny-add-st7789p3.patch           | 399 ++++++++++++++++++
 4 files changed, 472 insertions(+)
 create mode 100644 target/linux/mediatek/patches-6.18/998-drm-tiny-add-st7789p3.patch

diff --git a/package/kernel/linux/modules/video.mk b/package/kernel/linux/modules/video.mk
index ad7c533d71..d774b8d5e3 100644
--- a/package/kernel/linux/modules/video.mk
+++ b/package/kernel/linux/modules/video.mk
@@ -280,6 +280,27 @@ endef
 $(eval $(call KernelPackage,fb-tft-ili9486))
 
 
+define KernelPackage/drm-st7789p3
+  SUBMENU:=$(VIDEO_MENU)
+  TITLE:=DRM driver for Sitronix ST7789P3 display panels
+  DEPENDS:=+kmod-drm-mipi-dbi +kmod-drm-dma-helper
+  KCONFIG:=CONFIG_DRM_ST7789P3 \
+	CONFIG_DRM_FBDEV_EMULATION=y \
+	CONFIG_DRM_FBDEV_OVERALLOC=100
+  FILES:=$(LINUX_DIR)/drivers/gpu/drm/tiny/st7789p3.ko
+  AUTOLOAD:=$(call AutoProbe,st7789p3)
+endef
+
+define KernelPackage/drm-st7789p3/description
+  DRM driver for the Sitronix ST7789P3 240x320 IPS TFT LCD controller
+  using MIPI DBI Type C Option 3 (SPI + D/C GPIO).  Used on the GL.iNet
+  GL-BE10000 (Slate 7) front-panel display.  Provides /dev/fb0 via DRM
+  fbdev emulation.
+endef
+
+$(eval $(call KernelPackage,drm-st7789p3))
+
+
 define KernelPackage/cec-core
   SUBMENU:=$(VIDEO_MENU)
   TITLE:=CEC framework
diff --git a/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts b/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts
index 321a81fe08..ea896a24e0 100644
--- a/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts
+++ b/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts
@@ -289,3 +289,40 @@
 	pinctrl-0 = <&uart0_pins>;
 	status = "okay";
 };
+
+/*
+ * Front-panel LCD: Sitronix ST7789P3, 240x320 IPS, 4-wire SPI DBI.
+ * Stock pinmap (be10000-stock.dts):
+ *   SPI bus  : spi@11008800   (mainline &spi1, mediatek,ipm-spi-single)
+ *   Pinmux   : spi1_1 group   (UART1_RTS / PCM_CLK_I2S_BCLK / SPI2_CS pads)
+ *   RESET    : pio 10, active-low
+ *   DC       : pio 22, active-high
+ *   TE       : pio 9,  active-high (tearing-effect line for VSYNC sync)
+ *   Backlight: pwm-backlight (PWM ch2, declared above)
+ * SPI clock: start conservative at 16 MHz. Stock runs 52 MHz, but we
+ * ramp after bring-up verifies signal integrity.
+ */
+&spic_pins {
+	mux {
+		function = "spi";
+		groups = "spi1_1";
+	};
+};
+
+&spi1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spic_pins>;
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	panel@0 {
+		compatible = "sitronix,st7789p3";
+		reg = <0>;
+		spi-max-frequency = <16000000>;
+		rotation = <0>;
+		backlight = <&backlight>;
+		reset-gpios = <&pio 10 GPIO_ACTIVE_LOW>;
+		dc-gpios = <&pio 22 GPIO_ACTIVE_HIGH>;
+	};
+};
