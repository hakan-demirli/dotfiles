From e4dd86b21739018fea172ea9835528acdc91e842 Mon Sep 17 00:00:00 2001
From: emre <emre@local>
Date: Mon, 1 Jun 2026 22:29:40 +0200
Subject: [PATCH] be10000: enable fan, backlight (off), touchscreen (cst3530)

DTS:
  - fan PWM (ch1) + gpio-controlled 3.3V supply enabled
  - pwm-backlight on PWM ch2 (default-brightness-level=0 -> OFF at boot)
  - i2c0 enabled with hynitron,cst3530 cap_touch @0x58
    (reset gpio8, IRQ gpio11 falling, 240x320)

config-6.18 additions:
  - CONFIG_BACKLIGHT_CLASS_DEVICE=y, CONFIG_BACKLIGHT_PWM=y
  - CONFIG_INPUT_EVDEV=y, CONFIG_INPUT_TOUCHSCREEN=y
  - CONFIG_TOUCHSCREEN_HYNITRON_CSTXXX=y

patches-6.18/999-*: adds cst3530 compatible entry to the upstream
hynitron_cstxxx driver. The CST3530 chkcode (0xCACA220E & ~0xffff
== 0xCACA0000) matches cst3xx_data.ic_chkcode, but its bootloader
entry handshake differs. We skip the bootloader_enter sanity probe
and rely on firmware_info chkcode to validate the device.
---
 .../dts/mt7987a-glinet-gl-be10000.dts         | 52 ++++++++++++++++++
 target/linux/mediatek/filogic/config-6.18     |  5 ++
 ...chscreen-hynitron-cstxxx-add-cst3530.patch | 55 +++++++++++++++++++
 3 files changed, 112 insertions(+)
 create mode 100644 target/linux/mediatek/patches-6.18/999-input-touchscreen-hynitron-cstxxx-add-cst3530.patch

diff --git a/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts b/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts
index 52a3a4a75a..321a81fe08 100644
--- a/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts
+++ b/target/linux/mediatek/dts/mt7987a-glinet-gl-be10000.dts
@@ -62,6 +62,58 @@
 		gpio = <&pio 6 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm 2 50000 0>;	/* PWM ch 2, 20 kHz, normal polarity */
+		default-brightness-level = <0>;	/* OFF at boot */
+	};
+};
+
+&pio {
+	pwm1_pins: pwm1-pins {
+		mux {
+			function = "pwm";
+			groups = "pwm1_0";
+		};
+	};
+
+	pwm2_pins: pwm2-pins {
+		mux {
+			function = "pwm";
+			groups = "pwm2_0";
+		};
+	};
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm1_pins &pwm2_pins>;
+	status = "okay";
+};
+
+&fan {
+	fan-supply = <&fan_3v>;
+	interrupt-parent = <&pio>;
+	interrupts = <5 IRQ_TYPE_EDGE_RISING>;
+	pwms = <&pwm 1 50000 0>;
+	status = "okay";
+};
+
+&i2c0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0_pins>;
+	status = "okay";
+
+	cap_touch@58 {
+		compatible = "hynitron,cst3530";
+		reg = <0x58>;
+		reset-gpios = <&pio 8 GPIO_ACTIVE_LOW>;
+		interrupt-parent = <&pio>;
+		interrupts = <11 IRQ_TYPE_EDGE_FALLING>;
+		touchscreen-size-x = <240>;
+		touchscreen-size-y = <320>;
+	};
 };
 
 &spi2 {
