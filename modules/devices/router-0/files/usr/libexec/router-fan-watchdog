#!/bin/sh
# shellcheck disable=SC1091

. /lib/router-fan-modes.sh

OVERRIDE_FLAG=/var/run/router-fan.override

max_temp() {
	max=0
	for p in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
		[ -r "$p" ] || continue
		t=$(cat "$p" 2>/dev/null)
		[ -z "$t" ] && continue
		[ "$t" -gt "$max" ] 2>/dev/null && max="$t"
	done
	echo "$max"
}

rm -f "$OVERRIDE_FLAG"

while :; do
	mode=$(uci -q get router.fan.mode 2>/dev/null)
	manual_pwm=$(uci -q get router.fan.manual_pwm 2>/dev/null)
	safety_temp=$(uci -q get router.fan.safety_temp 2>/dev/null)
	interval=$(uci -q get router.fan.safety_interval 2>/dev/null)

	[ -z "$interval" ] && interval=5
	[ -z "$mode" ] && mode=auto
	[ -z "$safety_temp" ] && safety_temp=85000

	sleep "$interval"

	[ "$safety_temp" = "0" ] && continue

	if [ "$mode" = "auto" ] || [ "$mode" = "aggressive" ]; then
		if [ -e "$OVERRIDE_FLAG" ]; then
			router_fan_apply_mode "$mode" "$manual_pwm"
			rm -f "$OVERRIDE_FLAG"
			logger -t router-fan "watchdog: temps OK, restored mode=$mode"
		fi
		continue
	fi

	tmax=$(max_temp)
	if [ "$tmax" -ge "$safety_temp" ] 2>/dev/null; then
		if [ ! -e "$OVERRIDE_FLAG" ]; then
			logger -t router-fan "watchdog: temp ${tmax}mC >= ${safety_temp}mC. Overriding to auto (user mode=$mode)"
			router_fan_apply_mode auto "$manual_pwm"
			touch "$OVERRIDE_FLAG"
		fi
	else
		if [ -e "$OVERRIDE_FLAG" ]; then
			logger -t router-fan "watchdog: temp ${tmax}mC back below ${safety_temp}mC. Restoring mode=$mode"
			router_fan_apply_mode "$mode" "$manual_pwm"
			rm -f "$OVERRIDE_FLAG"
		fi
	fi
done
