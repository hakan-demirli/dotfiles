{
  "luci-app-router": {
    "description": "Grant access to the router panel",
    "read": {
      "cgi-io": ["exec"],
      "file": {
        "/usr/libexec/router-hardware-status": ["exec"],
        "/usr/libexec/router-captive-status": ["exec"],
        "/usr/libexec/router-ethernet-status": ["exec"]
      },
      "ubus": {
        "file": ["exec"]
      },
      "uci": ["router"]
    },
    "write": {
      "cgi-io": ["exec"],
      "file": {
        "/usr/libexec/router-ethernet-apply dual-lan": ["exec"],
        "/usr/libexec/router-ethernet-apply wired-wan": ["exec"]
      },
      "ubus": {
        "file": ["exec"],
        "uci": [
          "set",
          "delete",
          "add",
          "rename",
          "order",
          "commit",
          "revert",
          "reload_config"
        ]
      },
      "uci": ["router"]
    }
  }
}
