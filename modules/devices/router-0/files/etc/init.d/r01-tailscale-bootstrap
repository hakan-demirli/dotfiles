#!/bin/sh /etc/rc.common
# shellcheck shell=sh
# shellcheck disable=SC2016,SC2034
# One-shot first-boot registration with headscale.
#
# Reads:
#   /etc/tailscale/authkey            (0600, from config-overlay)
#   /etc/config/r01-tailscale         option login_server, option tag
# Runs at boot AFTER travelmate has brought up wwan. Skips if:
#   - `tailscale status` shows we're already registered, OR
#   - /etc/tailscale/authkey is missing (nothing to bootstrap with).
# Idempotent: safe to leave enabled forever. Only acts on first successful boot.
#
# Suppressed lints:
#   SC2016: procd command string is intentionally single-quoted. $VAR expands
#            at exec time inside the wrapped /bin/sh, not at parse time here
#   SC2034: USE_PROCD/START are contract vars consumed by /etc/rc.common

USE_PROCD=1
START=96

AUTHKEY=/etc/tailscale/authkey

boot() {
	start
}

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		set -eu

		LOGIN=$(uci -q get r01-tailscale.main.login_server 2>/dev/null || true)
		TAG=$(uci -q get r01-tailscale.main.tag 2>/dev/null || true)

		if [ -z "$LOGIN" ] || [ -z "$TAG" ]; then
			logger -t r01-tailscale "r01-tailscale UCI missing login_server or tag. Skipping"
			exit 0
		fi

		if [ ! -r '"$AUTHKEY"' ]; then
			logger -t r01-tailscale "no '"$AUTHKEY"'. Skipping first-boot registration"
			exit 0
		fi

		# If already registered, tailscale status returns a peer list.
		# Grep for "logged out" (fresh) vs a NodeKey line.
		if tailscale status --json 2>/dev/null | grep -q "\"BackendState\":\"Running\""; then
			logger -t r01-tailscale "already Running. Nothing to do"
			exit 0
		fi

		HOST=$(uci -q get system.@system[0].hostname 2>/dev/null || echo "$(cat /proc/sys/kernel/hostname)")
		AK=$(cat '"$AUTHKEY"')

		logger -t r01-tailscale "registering with $LOGIN as $HOST (tag=$TAG)"

		if tailscale up \
			--login-server="https://$LOGIN" \
			--auth-key="$AK" \
			--hostname="$HOST" \
			--advertise-tags="$TAG" \
			>/tmp/tailscale-bootstrap.log 2>&1
		then
			logger -t r01-tailscale "registration OK"
		else
			logger -t r01-tailscale "registration FAILED. See /tmp/tailscale-bootstrap.log"
			exit 1
		fi
	'
	procd_set_param respawn 0 0 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
