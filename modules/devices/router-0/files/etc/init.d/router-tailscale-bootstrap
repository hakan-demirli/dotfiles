#!/bin/sh /etc/rc.common
# shellcheck shell=sh
# shellcheck disable=SC2016,SC2034

USE_PROCD=1
START=96

AUTHKEY=/etc/tailscale/authkey

boot() {
	start
}

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		set -eu

		LOGIN=$(uci -q get router-tailscale.main.login_server 2>/dev/null || true)

		if [ -z "$LOGIN" ]; then
			logger -t router-tailscale "router-tailscale UCI missing login_server. Skipping"
			exit 0
		fi

		if [ ! -r '"$AUTHKEY"' ]; then
			logger -t router-tailscale "no '"$AUTHKEY"'. Skipping first-boot registration"
			exit 0
		fi

		i=0
		STATE=
		while [ "$i" -lt 60 ]; do
			STATE=$(tailscale status --json 2>/dev/null \
				| sed -n "s/.*\"BackendState\":[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
				| head -n1 || true)
			case "$STATE" in
			NeedsLogin | NeedsMachineAuth | Stopped | Running)
				break
				;;
			esac
			i=$((i + 1))
			sleep 1
		done

		if [ "$STATE" != "NeedsLogin" ]; then
			logger -t router-tailscale "backend state ${STATE:-unavailable} is not NeedsLogin. Nothing to do"
			exit 0
		fi

		HOST=$(uci -q get system.@system[0].hostname 2>/dev/null || echo "$(cat /proc/sys/kernel/hostname)")
		AK=$(cat '"$AUTHKEY"')

		logger -t router-tailscale "registering with $LOGIN as $HOST"

		if tailscale up \
			--login-server="https://$LOGIN" \
			--auth-key="$AK" \
			--hostname="$HOST" \
			>/tmp/tailscale-bootstrap.log 2>&1
		then
			logger -t router-tailscale "registration OK as tag:bootstrap. Promote with headscale nodes tag"
		else
			logger -t router-tailscale "registration FAILED. See /tmp/tailscale-bootstrap.log"
			exit 1
		fi
	'
	procd_set_param respawn 0 0 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
