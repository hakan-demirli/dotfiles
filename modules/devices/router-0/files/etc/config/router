config router 'fan'

	option mode 'auto'
	option manual_pwm '128'

	option safety_temp '85000'

	option safety_interval '5'

config router 'ethernet'
	option mode 'dual-lan'

config router 'captive'

	option enabled '1'

	option check_interval '30'

	option probe_url 'http://connectivitycheck.gstatic.com/generate_204'

	option probe_timeout '8'

	option bypass_timeout '1800'
