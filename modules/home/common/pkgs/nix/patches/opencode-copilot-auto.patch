+    expect(models.get(Model.ID.make("auto"))?.limit).toEqual({ context: 64000, input: 64000, output: 8192 })
+    expect(sessions).toEqual([{ authorization: "Bearer token", contentType: "text/plain;charset=UTF-8" }])
