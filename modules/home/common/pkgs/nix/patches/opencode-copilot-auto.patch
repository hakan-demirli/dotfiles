@@ -0,0 +1,104 @@
+import type { LanguageModelV3, LanguageModelV3CallOptions } from "@ai-sdk/provider"
+import { expect, test } from "bun:test"
+import { CopilotAuto } from "@opencode/core/github-copilot/auto"
+
+type Route = (url: string, init?: RequestInit) => Response
+
+const options = {
+  prompt: [
+    { role: "system", content: "You are a coding agent." },
+    { role: "user", content: [{ type: "text", text: "first" }] },
+    { role: "assistant", content: [{ type: "text", text: "done" }] },
+    { role: "user", content: [{ type: "text", text: "refactor the parser" }] },
+  ],
+} satisfies LanguageModelV3CallOptions
+
+const session = (expiresIn = 3600) =>
+  Response.json({
+    available_models: ["big", "small"],
+    selected_model: "big",
+    session_token: "session",
+    expires_at: Math.floor(Date.now() / 1000) + expiresIn,
+  })
+
+function router(route: Route) {
+  const requests: Array<{ url: string; init?: RequestInit }> = []
+  const calls: Array<{ modelID: string; headers: LanguageModelV3CallOptions["headers"] }> = []
+  const model = CopilotAuto.create({
+    baseURL: "https://api.githubcopilot.com",
+    fetch: async (input, init) => {
+      const url = String(input)
+      requests.push({ url, init })
+      return route(url, init)
+    },
+    language: (modelID) =>
+      ({
+        specificationVersion: "v3",
+        provider: "test",
+        modelId: modelID,
+        supportedUrls: {},
+        doGenerate: async (call: LanguageModelV3CallOptions) => {
+          calls.push({ modelID, headers: call.headers })
+          return { modelID } as unknown as Awaited<ReturnType<LanguageModelV3["doGenerate"]>>
+        },
+        doStream: async (call: LanguageModelV3CallOptions) => {
+          calls.push({ modelID, headers: call.headers })
+          return { modelID } as unknown as Awaited<ReturnType<LanguageModelV3["doStream"]>>
+        },
+      }) satisfies LanguageModelV3,
+  })
+  return { model, requests, calls }
+}
+
+test("routes each turn to the model that the router chooses", async () => {
+  const { model, requests, calls } = router((url) =>
+    url.endsWith("/models/session") ? session() : Response.json({ chosen_model: "small" }),
+  )
+
+  await model.doStream(options)
+
+  expect(model.modelId).toBe("auto")
+  expect(calls).toEqual([{ modelID: "small", headers: { "copilot-session-token": "session" } }])
+  expect(requests.map((request) => request.url)).toEqual([
+    "https://api.githubcopilot.com/models/session",
+    "https://api.githubcopilot.com/models/session/intent",
+  ])
+  expect(new Headers(requests[1]?.init?.headers).get("copilot-session-token")).toBe("session")
+  expect(JSON.parse(String(requests[1]?.init?.body))).toMatchObject({
+    prompt: "refactor the parser",
+    available_models: ["big", "small"],
+    prompt_char_count: "refactor the parser".length,
+    turn_number: 2,
+  })
+})
+
+test("falls back to the session model when routing fails or picks a model that the session did not offer", async () => {
+  const intents = [new Response("unavailable", { status: 503 }), Response.json({ chosen_model: "elsewhere" })]
+  const { model, calls } = router((url) => (url.endsWith("/models/session") ? session() : intents.shift()!))
+
+  await model.doGenerate(options)
+  await model.doGenerate(options)
+
+  expect(calls.map((call) => call.modelID)).toEqual(["big", "big"])
+})
+
+test("reuses the router session until it is about to expire", async () => {
+  const opened = async (expiresIn: number) => {
+    const { model, requests } = router((url) =>
+      url.endsWith("/models/session") ? session(expiresIn) : Response.json({ chosen_model: "small" }),
+    )
+    await model.doGenerate(options)
+    await model.doGenerate(options)
+    return requests.filter((request) => request.url.endsWith("/models/session")).length
+  }
+
+  expect(await opened(3600)).toBe(1)
+  expect(await opened(10)).toBe(2)
+})
+
+test("fails the request when Copilot refuses the router session", async () => {
+  const { model, calls } = router(() => new Response("unauthorized", { status: 401 }))
+
+  await expect(model.doGenerate(options)).rejects.toThrow("Failed to create Copilot auto session: 401")
+  expect(calls).toEqual([])
+})
