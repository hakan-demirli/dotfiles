+
+export function endpoint(remote: Pick<RemoteModel, "supported_endpoints">): Endpoint | undefined {
+  if (remote.supported_endpoints?.includes("/v1/messages")) return "messages"
+  if (remote.supported_endpoints?.includes("/responses")) return "responses"
+  if (remote.supported_endpoints?.includes("/chat/completions")) return "chat"
+  return undefined
+}
+
+// The Auto session is the only authoritative list of the models Auto may route to: /models
+// also lists utility models that Auto never selects.
+async function autoRoutable(baseURL: string, headers: RequestInit["headers"]) {
+  const request = new Headers(headers)
+  request.set("Content-Type", "text/plain;charset=UTF-8")
+  return fetch(`${baseURL}/models/session`, {
+    method: "POST",
+    headers: request,
+    body: JSON.stringify({ auto_mode: { model_hints: [autoModelID] } }),
+    signal: AbortSignal.timeout(5_000),
+  })
+    .then(async (response) => {
+      if (!response.ok) return undefined
+      const models = Option.getOrUndefined(decodeAutoSession(await response.json()))?.available_models
+      return models?.length ? models : undefined
+    })
+    .catch(() => undefined)
+}
+
+// Size Auto from the models it can route to, so compaction triggers before the smallest of
+// them overflows. Without that list, use conservative defaults instead of the smallest model
+// on the account, which is usually a utility model that Auto never selects.
+function autoModel(models: Snapshot, routable: readonly string[] | undefined): UsableModel {
+  const limits = (routable ?? []).flatMap((id) => {
+    const model = models.get(id)
+    return model ? [model.capabilities.limits] : []
+  })
+  const min = (pick: (limit: UsableModel["capabilities"]["limits"]) => number | undefined, fallback: number) => {
+    const values = limits.map(pick).filter((value): value is number => value !== undefined && value > 0)
+    return values.length ? Math.min(...values) : fallback
+  }
+  const prompt = min((limit) => limit.max_prompt_tokens, autoContextFallback)
+  return {
+    model_picker_enabled: true,
+    id: autoModelID,
+    name: "Auto",
+    version: autoModelID,
+    capabilities: {
+      family: autoModelID,
+      limits: {
+        max_context_window_tokens: min((limit) => limit.max_context_window_tokens ?? limit.max_prompt_tokens, prompt),
+        max_output_tokens: min((limit) => limit.max_output_tokens, autoOutputFallback),
+        max_prompt_tokens: prompt,
+      },
+      supports: { streaming: true, tool_calls: true },
+    },
+  }
 }
 
