@@ -0,0 +1,131 @@
+export * as CopilotAuto from "./auto.js"
+
+import type { LanguageModelV3, LanguageModelV3CallOptions, LanguageModelV3Prompt } from "@ai-sdk/provider"
+import { Option, Schema } from "effect"
+import { autoModelID } from "./models.js"
+
+const requestTimeout = 5_000
+const sessionExpiryMargin = 30
+
+const Session = Schema.Struct({
+  available_models: Schema.optional(Schema.Array(Schema.String)),
+  selected_model: Schema.optional(Schema.String),
+  session_token: Schema.String,
+  expires_at: Schema.Number,
+})
+const Intent = Schema.Struct({ chosen_model: Schema.optional(Schema.String) })
+const decodeSession = Schema.decodeUnknownSync(Session)
+const decodeIntent = Schema.decodeUnknownOption(Intent)
+
+type Fetch = (input: Parameters<typeof fetch>[0], init?: RequestInit) => Promise<Response>
+
+export interface Input {
+  readonly baseURL: string
+  readonly fetch: Fetch
+  /** Resolves a model that the router selected to the Copilot transport that serves it. */
+  readonly language: (modelID: string) => LanguageModelV3
+}
+
+interface RouterSession {
+  readonly availableModels: readonly string[]
+  readonly selectedModel: string
+  readonly token: string
+  readonly expiresAt: number
+}
+
+export function create(input: Input): LanguageModelV3 {
+  return new AutoLanguageModel(input)
+}
+
+// Copilot exposes Auto as a routing service, not as a model. A session names the models that
+// the plan may route to, and an intent call selects one of them for each turn. Free and
+// Student plans have no other path to inference.
+class AutoLanguageModel implements LanguageModelV3 {
+  readonly specificationVersion = "v3"
+  readonly provider = "github-copilot.auto"
+  readonly modelId = autoModelID
+  readonly supportedUrls = {}
+  private session: RouterSession | undefined
+
+  constructor(private readonly input: Input) {}
+
+  async doGenerate(options: LanguageModelV3CallOptions) {
+    const routed = await this.route(options)
+    return routed.language.doGenerate(routed.options)
+  }
+
+  async doStream(options: LanguageModelV3CallOptions) {
+    const routed = await this.route(options)
+    return routed.language.doStream(routed.options)
+  }
+
+  private async route(options: LanguageModelV3CallOptions) {
+    const session = await this.open(options.abortSignal)
+    // The router is advisory: the session already names a usable model, so a routing
+    // failure falls back to that model instead of failing the request.
+    const modelID = await this.intent(session, options).catch(() => undefined)
+    return {
+      language: this.input.language(modelID ?? session.selectedModel),
+      options: {
+        ...options,
+        headers: { ...options.headers, "copilot-session-token": session.token },
+      },
+    }
+  }
+
+  private async open(abort: AbortSignal | undefined) {
+    const now = Math.floor(Date.now() / 1000)
+    if (this.session && this.session.expiresAt > now + sessionExpiryMargin) return this.session
+
+    const response = await this.input.fetch(`${this.input.baseURL}/models/session`, {
+      method: "POST",
+      headers: { "Content-Type": "text/plain;charset=UTF-8" },
+      body: JSON.stringify({ auto_mode: { model_hints: [autoModelID] } }),
+      signal: signal(abort),
+    })
+    if (!response.ok) throw new Error(`Failed to create Copilot auto session: ${response.status}`)
+    const session = decodeSession(await response.json())
+    if (!session.selected_model) throw new Error("Copilot auto session did not select a model")
+    this.session = {
+      availableModels: session.available_models ?? [session.selected_model],
+      selectedModel: session.selected_model,
+      token: session.session_token,
+      expiresAt: session.expires_at,
+    }
+    return this.session
+  }
+
+  private async intent(session: RouterSession, options: LanguageModelV3CallOptions) {
+    const prompt = promptText(options.prompt)
+    const response = await this.input.fetch(`${this.input.baseURL}/models/session/intent`, {
+      method: "POST",
+      headers: { "Content-Type": "text/plain;charset=UTF-8", "copilot-session-token": session.token },
+      body: JSON.stringify({
+        prompt,
+        available_models: session.availableModels,
+        session_id: `opencode-session://${autoModelID}`,
+        reference_count: 0,
+        prompt_char_count: prompt.length,
+        turn_number: options.prompt.filter((message) => message.role === "user").length,
+        routing_method: "hydra",
+        copilot_plan: "individual",
+      }),
+      signal: signal(options.abortSignal),
+    })
+    if (!response.ok) throw new Error(`Failed to route Copilot auto model: ${response.status}`)
+    const chosen = Option.getOrUndefined(decodeIntent(await response.json()))?.chosen_model
+    // Never route to a model that the session did not offer.
+    return chosen && session.availableModels.includes(chosen) ? chosen : undefined
+  }
+}
+
+function signal(abort: AbortSignal | undefined) {
+  const timeout = AbortSignal.timeout(requestTimeout)
+  return abort ? AbortSignal.any([abort, timeout]) : timeout
+}
+
+function promptText(prompt: LanguageModelV3Prompt) {
+  const message = prompt.findLast((item) => item.role === "user")
+  if (message?.role !== "user") return ""
+  return message.content.flatMap((part) => (part.type === "text" ? [part.text] : [])).join("\n")
+}
