+          selected_model: "big",
+          session_token: "session",
+          expires_at: Math.floor(Date.now() / 1000) + 3600,
+        })
+      }
+      return Response.json({
+        data: [
+          // Listed on the account but never routed to, so it must not shrink the context of Auto.
+          limited("utility", { max_context_window_tokens: 16384, max_output_tokens: 4096, max_prompt_tokens: 16384 }),
+          limited("big", { max_context_window_tokens: 400000, max_output_tokens: 128000, max_prompt_tokens: 272000 }),
+          limited("small", { max_context_window_tokens: 64000, max_output_tokens: 8192, max_prompt_tokens: 64000 }),
+        ],
+      })
+    },
