{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/nix/store/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/sys/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/proc/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/bin/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/boot/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Desktop/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.storage/persistent/Desktop/*",
      "effect": "allow"
    }
  ],
  "update": "disable",
  "lsp": false,
  "formatter": false,
  "snapshots": false,
  "instructions": [".agent/*.md", ".hydrate/agent/*.md"],
  "providers": {
    "gufo": {
      "name": "Gufo",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://server-dev-3.ts.sshr.polarbearvuzi.com:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "coding": {
          "name": "Gufo Coding",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "limit": {
            "context": 262144,
            "input": 253952,
            "output": 8192
          },
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": [
            {
              "id": "off",
              "settings": {
                "reasoningEffort": "none"
              }
            },
            {
              "id": "minimal",
              "settings": {
                "reasoningEffort": "minimal"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        }
      }
    },
    "proxy-anthropic": {
      "name": "Proxy Anthropic",
      "canonical": "anthropic",
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "apiKey": "local"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-fable-5-1": {
          "name": "Claude Fable 5.1",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    },
    "proxy-openai": {
      "name": "Proxy OpenAI",
      "canonical": "openai",
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "apiKey": "local"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    }
  },
  "plugins": ["@mohak34/opencode-notifier@1.1.1"]
}
