{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow",
      "/tmp/**": "allow",
      "/sys/**": "allow",
      "/proc/**": "allow",
      "/bin/**": "allow",
      "/boot/**": "allow",
      "~/Desktop/**": "allow",
      "~/.storage/persistent/Desktop/**": "allow"
    }
  },
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "snapshot": false,
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-antigravity-auth-updated@latest",
    "@mohak34/opencode-notifier@latest",
    "./plugins/office"
  ]
}
