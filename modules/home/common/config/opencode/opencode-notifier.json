{
  "notification": true,
  "command": {
    "enabled": true,
    "path": "sh",
    "args": [
      "-c",
      "HN=$(hostname); if [ \"$HN\" != \"laptop-1\" ]; then tnotify.sh \"opencode done on $HN in {projectName}\"; curl -d \"opencode done on $HN in {projectName}\" -H \"Title: Opencode ($HN) [{projectName}]\" http://vps-oracle-0:8111/emre-laptop; fi"
    ]
  },
  "events": {
    "user_message": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "session_started": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "client_connected": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "subagent_complete": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "user_cancelled": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    },
    "plan_exit": {
      "sound": false,
      "notification": false,
      "command": false,
      "bell": false
    }
  }
}
